<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="198.0" prefWidth="405.0" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="AddWordController">

    <Label prefWidth="127.0" text="English Word:" />
    <TextField fx:id="englishWordTextField" />

    <Label text="Vietnamese Explanation:" />
    <TextField fx:id="vietnameseExplanationTextField" />

    <Button onAction="#addWordAction" text="Add Word" />
</VBox>
