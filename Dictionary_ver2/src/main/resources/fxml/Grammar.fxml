<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>


<BorderPane xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.GrammarController">
   <center>
      <AnchorPane prefHeight="400.0" prefWidth="600.0">
          <children>
              <Label layoutX="220.0" layoutY="40.0" prefHeight="50.0" prefWidth="134.0" text="GRAMMAR STUDY" />
              <AnchorPane layoutX="20.0" layoutY="90.0" prefHeight="279.0" prefWidth="200.0">
                  <children>
                      <Label layoutX="58.0" layoutY="14.0" text="GRAMMAR LIST" />
                      <ListView fx:id="grammarName" layoutX="5.0" layoutY="50.0" onMouseClicked="#onMouseClickView" prefHeight="200.0" prefWidth="190.0" />
                  </children>
              </AnchorPane>
              <AnchorPane layoutX="238.0" layoutY="90.0" prefHeight="279.0" prefWidth="303.0">
                  <children>
                      <Label layoutX="113.0" layoutY="14.0" text="DEFINITION" />
                      <TextArea fx:id="grammarDef" layoutX="14.0" layoutY="52.0" prefHeight="200.0" prefWidth="278.0" />
                  </children>
              </AnchorPane>
          </children>
      </AnchorPane>
   </center>
</BorderPane>
