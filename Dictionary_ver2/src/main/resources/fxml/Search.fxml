<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.web.WebView?>


<BorderPane xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.SearchController">
   <center>
      <AnchorPane prefHeight="400.0" prefWidth="600.0">
         <children>
            <ListView fx:id="listWord" layoutX="26.0" layoutY="79.0" onMouseClicked="#onMouseClickListView" prefHeight="306.0" prefWidth="226.0" />
            <TextField fx:id="searchField" layoutX="26.0" layoutY="40.0" onAction="#onActionSearchBtn" prefHeight="26.0" prefWidth="162.0" />
            <Button layoutX="201.0" layoutY="42.0" mnemonicParsing="false" onAction="#onActionSearchBtn" text="Search" />
            <WebView fx:id="definitionArea" layoutX="290.0" layoutY="80.0" prefHeight="306.0" prefWidth="303.0" />
            <Button layoutX="290.0" layoutY="41.0" mnemonicParsing="false" onAction="#onActionUpdate" text="Update" />
            <Button layoutX="416.0" layoutY="42.0" mnemonicParsing="false" onAction="#onActionDelete" text="Delete" />
            <Button layoutX="534.0" layoutY="42.0" mnemonicParsing="false" onAction="#onActionSpeak" text="Speak" />
            <AnchorPane fx:id="updateWindow" layoutX="316.0" layoutY="123.0" prefHeight="200.0" prefWidth="200.0">
               <children>
                  <Label layoutX="61.0" layoutY="14.0" prefHeight="39.0" prefWidth="78.0" text="New definition" />
                  <TextArea fx:id="newDefinition" layoutX="12.0" layoutY="53.0" prefHeight="98.0" prefWidth="178.0" />
                  <Button layoutX="75.0" layoutY="161.0" mnemonicParsing="false" onAction="#onActionSubmit" text="Submit" />
               </children>
            </AnchorPane>
         </children>
      </AnchorPane>
   </center>
</BorderPane>
